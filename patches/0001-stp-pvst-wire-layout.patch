+/* Wire fields can start at odd addresses. Never access them through a cast
+ * to an ordinarily aligned integer pointer. Read both MAC pieces before
+ * writing so that the in-place conversions used by BPDU encode/decode work. */
+static inline uint16_t stp_load_u16(const void *src)
+{
+    uint16_t value;
+    memcpy(&value, src, sizeof(value));
+    return value;
+}
+
+static inline void stp_store_u16(void *dst, uint16_t value)
+{
+    memcpy(dst, &value, sizeof(value));
+}
+
+static inline void stp_mac_net_to_host(void *dst, const void *src)
+{
+    uint32_t high;
+    uint16_t low;
+    memcpy(&high, src, sizeof(high));
+    memcpy(&low, (const unsigned char *)src + sizeof(high), sizeof(low));
+    high = ntohl(high);
+    low = ntohs(low);
+    memcpy(dst, &high, sizeof(high));
+    memcpy((unsigned char *)dst + sizeof(high), &low, sizeof(low));
+}
+
+static inline void stp_mac_host_to_net(void *dst, const void *src)
+{
+    uint32_t high;
+    uint16_t low;
+    memcpy(&high, src, sizeof(high));
+    memcpy(&low, (const unsigned char *)src + sizeof(high), sizeof(low));
+    high = htonl(high);
+    low = htons(low);
+    memcpy(dst, &high, sizeof(high));
+    memcpy((unsigned char *)dst + sizeof(high), &low, sizeof(low));
+}
+
+#define NET_TO_HOST_MAC(dst, src) stp_mac_net_to_host((dst), (src))
+#define HOST_TO_NET_MAC(dst, src) stp_mac_host_to_net((dst), (src))
  
