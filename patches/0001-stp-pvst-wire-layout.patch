+STP_WIRE_ASSERT(offsetof(MAC_HEADER, source_address) == 6, "Ethernet source offset");
+STP_WIRE_ASSERT(offsetof(MAC_HEADER, length) == 12, "Ethernet length offset");
+STP_WIRE_ASSERT(sizeof(LLC_HEADER) == 3, "LLC header must be three wire bytes");
+STP_WIRE_ASSERT(sizeof(SNAP_HEADER) == 8, "SNAP header must be eight wire bytes");
  
